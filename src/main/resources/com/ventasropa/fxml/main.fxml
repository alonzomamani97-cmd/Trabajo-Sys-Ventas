<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.ComboBox?>

<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ventasropa.controller.VentasController"  styleClass="root-pane">

    <!-- BARRA SUPERIOR -->
    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1A1235; -fx-border-color: #00E5FF; -fx-border-width: 0 0 2px 0;">
            <padding>
                <Insets top="15" right="25" bottom="15" left="25"/>
            </padding>
            <Label text="ROPA BOUTIQUE PRO" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Módulo de Gestión de Inventario" style="-fx-font-size: 13px; -fx-text-fill: #00E5FF; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <!-- PANEL IZQUIERDO: FORMULARIO -->
    <left>
        <VBox spacing="0" prefWidth="380">
            <padding>
                <Insets top="25" right="15" bottom="25" left="25"/>
            </padding>

            <VBox spacing="20" style="-fx-background-color: #151A24; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-border-color: #242D40; -fx-padding: 20px;">
                <Label text="Registro de Producto" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #00E5FF;" />

                <GridPane hgap="15" vgap="15">
                    <Label text="NOMBRE DEL PRODUCTO" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #6B7A99; -fx-font-size: 11px; -fx-font-weight: bold;" />
                    <TextField fx:id="txtNombre" promptText="Ej. Casaca Urbana" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2" style="-fx-background-color: #0B0E14; -fx-border-color: #242D40; -fx-text-fill: #FFFFFF; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-padding: 8px;" />

                    <Label text="PRECIO ($)" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #6B7A99; -fx-font-size: 11px; -fx-font-weight: bold;" />
                    <TextField fx:id="txtPrecio" promptText="0.00" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-background-color: #0B0E14; -fx-border-color: #242D40; -fx-text-fill: #FFFFFF; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-padding: 8px;" />

                    <Label text="STOCK" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #6B7A99; -fx-font-size: 11px; -fx-font-weight: bold;" />
                    <TextField fx:id="txtStock" promptText="Unidades" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-background-color: #0B0E14; -fx-border-color: #242D40; -fx-text-fill: #FFFFFF; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-padding: 8px;" />

                    <Label text="TALLA" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-text-fill: #6B7A99; -fx-font-size: 11px; -fx-font-weight: bold;" />
                    <ComboBox fx:id="cbTalla" promptText="Seleccionar..." GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2" maxWidth="Infinity" style="-fx-background-color: #0B0E14; -fx-border-color: #242D40; -fx-background-radius: 5px; -fx-border-radius: 5px;" />
                </GridPane>

                <VBox spacing="10">
                    <HBox spacing="10" alignment="CENTER">
                        <Button text="GUARDAR" onAction="#onGuardarClick" style="-fx-background-color: #00C853; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5px;" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Button text="EDITAR" onAction="#onEditarClick" style="-fx-background-color: #FF6D00; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5px;" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    </HBox>
                    <HBox spacing="10" alignment="CENTER">
                        <Button text="CANCELAR" onAction="#onCancelarClick" style="-fx-background-color: #242D40; -fx-text-fill: #9CA3AF; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5px;" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Button text="ELIMINAR" onAction="#onEliminarClick" style="-fx-background-color: #D50000; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5px;" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </left>

    <!-- PANEL DERECHO: TABLA Y BUSCADOR -->
    <center>
        <VBox spacing="0">
            <padding>
                <Insets top="25" right="25" bottom="25" left="10"/>
            </padding>

            <VBox spacing="15" style="-fx-background-color: #151A24; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-border-color: #242D40; -fx-padding: 20px;" VBox.vgrow="ALWAYS">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Filtrar:" style="-fx-text-fill: #6B7A99; -fx-font-weight: bold;" />
                    <TextField fx:id="txtBuscar" promptText="Buscar producto por nombre..." style="-fx-background-color: #0B0E14; -fx-border-color: #242D40; -fx-text-fill: #FFFFFF; -fx-background-radius: 15px; -fx-border-radius: 15px; -fx-padding: 8px 12px;" HBox.hgrow="ALWAYS" />
                    <Button text="BUSCAR" onAction="#onBuscarClick" style="-fx-background-color: #0066FF; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5px; -fx-padding: 8px 15px;" />
                </HBox>

                <TableView fx:id="tablaPrendas" VBox.vgrow="ALWAYS" style="-fx-background-color: #151A24;">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="colNombre" text="PRODUCTO" prefWidth="250"/>
                        <TableColumn fx:id="colTalla" text="TALLA" prefWidth="120"/>
                        <TableColumn fx:id="colPrecio" text="P. UNIT" prefWidth="130"/>
                        <TableColumn fx:id="colStock" text="STOCK" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>